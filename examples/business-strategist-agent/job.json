{
  "name": "business-strategist-agent",
  "kind": "lora",
  "base_model": "Qwen/Qwen2.5-0.5B-Instruct",
  "dataset": {
    "url": "data/corpus-full.jsonl",
    "format": "jsonl",
    "source": "https://rssamplifier.com/topics/business"
  },
  "hyperparams": {
    "lr": 0.0002,
    "batch_size": 2,
    "epochs": 1,
    "max_steps": 400,
    "seq_len": 256,
    "lora_r": 8,
    "dtype": "bfloat16"
  },
  "output": {
    "destination_url": "out/business-strategist-agent",
    "format": "peft-lora"
  }
}
